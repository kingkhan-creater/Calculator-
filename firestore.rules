rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for auth verification
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        ((request.auth.token.role == 'ADMIN') || 
         (request.auth.token.role == 'super_admin') || 
         (request.auth.token.admin == true) ||
         (request.auth.token.email == 'king.khan648k@gmail.com'));
    }

    // 1. User Profile Document
    match /users/{userId} {
      allow read, update: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow delete: if isOwner(userId) || isAdmin();

      // 2. User Folders Subcollection
      match /folders/{folderId} {
        allow read, write, create, update, delete: if isOwner(userId) || isAdmin();
      }

      // 3. User Vault Media Metadata Subcollection
      match /vault_media/{mediaId} {
        allow read, write, create, update, delete: if isOwner(userId) || isAdmin();
      }

      // 4. User Recordings Metadata Subcollection
      match /recordings/{recordingId} {
        allow read, write, create, update, delete: if isOwner(userId) || isAdmin();
      }
    }

    // 5. Cloud Recordings Collection (Guest and Registered user cloud recordings)
    match /cloud_recordings/{recordingId} {
      allow read: if isAuthenticated() && (
        resource.data.anonymousAccountReference == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.anonymousAccountReference == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.anonymousAccountReference == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.anonymousAccountReference == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // 6. Admin Records Collection & Subscriptions
    match /admin_records/{recordId} {
      allow read, write: if isAdmin();
    }

    // 7. Admin Audit Logs (Append-only by Admin, Readable by Admin)
    match /admin_audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false; // Immutable audit trail
    }

    // 8. In-App Announcements & System Updates
    match /system_announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /system_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 9. License Keys / Activation Vouchers (No-Gmail Subscriptions)
    match /license_keys/{keyId} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && (
        // Allow user to claim/redeem key if not yet redeemed, or admin
        (resource.data.isRedeemed == false && request.resource.data.redeemedByUid == request.auth.uid) ||
        isAdmin()
      );
      allow create, delete: if isAdmin();
    }

    // Default deny rule for any other collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
